{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:production-policy",
  "type": "object",
  "required": ["schema_version", "policy_id", "policy_version", "status", "environment", "source_commit", "plan_sha256", "target", "findings", "catalog_version", "evaluated_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "policy_id": {"const": "production-readiness"},
    "policy_version": {"type": "string"},
    "status": {"enum": ["passed", "failed"]},
    "environment": {"type": "string"},
    "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"},
    "plan_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
    "target": {"type": "object", "additionalProperties": {"type": "string"}},
    "findings": {"type": "array", "maxItems": 200, "items": {"$ref": "#/$defs/finding"}},
    "catalog_version": {"type": "string"},
    "evaluated_at": {"format": "date-time", "type": "string"}
  },
  "$defs": {"finding": {"type": "object", "required": ["policy_id", "policy_version", "address", "requirement", "evidence", "severity", "remediation", "exemptible"], "properties": {"policy_id": {"type": "string"}, "policy_version": {"type": "string"}, "address": {"maxLength": 200, "type": "string"}, "requirement": {"maxLength": 240, "type": "string"}, "evidence": {"maxLength": 160, "type": "string"}, "severity": {"const": "blocking"}, "remediation": {"maxLength": 240, "type": "string"}, "exemptible": {"type": "boolean"}}}}
}
