{
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:release-manifest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable platform release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "version", "source_commit", "builder", "artifacts", "qualification", "compatibility", "policy_bundle_sha256", "provider_lock_sha256", "migration_class", "known_limitations", "tested_matrix", "component_versions", "schema_ranges", "qualification_observations", "runtime_exceptions", "publisher", "published_at", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "builder": {"type": "object", "additionalProperties": false, "required": ["workflow_sha", "run_id"], "properties": {"workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "run_id": {"type": "string", "pattern": "^[1-9][0-9]*$"}}},
    "artifacts": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["kind", "reference", "sha256"], "properties": {"kind": {"type": "string", "enum": ["action", "workflow", "module", "source", "image", "contract", "runtime"]}, "reference": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "qualification": {"type": "object", "additionalProperties": true, "required": ["status", "evidence_sha256"], "properties": {"status": {"const": "passed"}, "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "compatibility": {"type": "object", "minProperties": 1},
    "policy_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "migration_class": {"type": "string", "enum": ["none", "patch", "minor", "major"]},
    "known_limitations": {"type": "array", "items": {"type": "string", "maxLength": 240}},
    "tested_matrix": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "component_versions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "schema_ranges": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "qualification_observations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "observed_at"], "additionalProperties": false, "properties": {"name": {"type": "string", "minLength": 1}, "observed_at": {"type": "string", "format": "date-time"}}}},
    "runtime_exceptions": {"type": "array", "items": {"type": "string", "maxLength": 240}},
    "publisher": {"type": "object", "additionalProperties": false, "required": ["oidc_actor"], "properties": {"oidc_actor": {"type": "string", "minLength": 1}}},
    "published_at": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
