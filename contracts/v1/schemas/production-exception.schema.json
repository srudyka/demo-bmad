{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:production-exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["policy_id", "policy_version", "address", "environment", "source_commit", "plan_sha256", "owner", "justification", "approver", "compensating_control", "expires_at", "review_at", "signature"],
  "properties": {
    "policy_id": {"const": "production-readiness"}, "policy_version": {"type": "string"}, "address": {"minLength": 1, "type": "string", "not": {"pattern": "[*]"}}, "environment": {"const": "production"}, "source_commit": {"pattern": "^[0-9a-f]{40}$", "type": "string"}, "plan_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}, "owner": {"minLength": 1, "type": "string"}, "justification": {"minLength": 1, "maxLength": 1000, "type": "string"}, "approver": {"minLength": 1, "type": "string"}, "compensating_control": {"minLength": 1, "maxLength": 1000, "type": "string"}, "expires_at": {"format": "date-time", "type": "string"}, "review_at": {"format": "date-time", "type": "string"}, "signature": {"pattern": "^hmac-sha256:[0-9a-f]{64}$", "type": "string"}
  }
}
