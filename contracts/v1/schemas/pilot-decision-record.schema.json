{
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:pilot-decision-record",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pilot Decision Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_type", "decision", "launch_status", "bindings", "checklist_id", "measurement_status", "measurement_evidence_sha256", "evidence_ids", "rationale", "owners", "due_actions", "scope", "effective_date", "decided_at", "execution_proven", "approval_roles", "rollout_policy", "evidence_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "pilot-decision-record"},
    "decision": {"enum": ["ACCEPTED", "REMEDIATE_AND_REPEAT", "REJECTED"]},
    "launch_status": {"enum": ["BLOCKED", "READY_FOR_REVIEW", "APPROVED_TO_START", "IN_PROGRESS", "PAUSED", "EVIDENCE_PENDING"]},
    "bindings": {"$ref": "pilot-launch-checklist.schema.json#/$defs/bindings"},
    "checklist_id": {"type": "string", "minLength": 1},
    "measurement_status": {"enum": ["MEASURED", "UNKNOWN", "INCOMPLETE", "INCONCLUSIVE", "NOT_COMPARABLE", "BLOCKED"]},
    "measurement_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "rationale": {"type": "string", "minLength": 1},
    "owners": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "due_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "scope": {"type": "string", "minLength": 1},
    "effective_date": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "decided_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "execution_proven": {"const": false},
    "approval_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rollout_policy": {"type": "object", "additionalProperties": false, "required": ["support_owner", "supported_versions", "deprecation_communication", "exception_policy", "rollback_pause_criteria", "rollout_scope", "new_jobs_use_standard_module", "materially_changed_jobs_migrate", "exceptions_governed", "metrics_continue_from_baseline"], "properties": {"support_owner": {"type": "string", "minLength": 1}, "supported_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "deprecation_communication": {"type": "string", "minLength": 1}, "exception_policy": {"type": "string", "minLength": 1}, "rollback_pause_criteria": {"type": "string", "minLength": 1}, "rollout_scope": {"type": "string", "minLength": 1}, "new_jobs_use_standard_module": {"type": "boolean"}, "materially_changed_jobs_migrate": {"type": "boolean"}, "exceptions_governed": {"type": "boolean"}, "metrics_continue_from_baseline": {"type": "boolean"}}},
    "evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
