{
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:deployment-identity",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "deployment_identity_id": {
      "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/sha256"
    },
    "identity": {
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/account_id"
        },
        "artifact_checksums": {
          "additionalProperties": {
            "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/sha256"
          },
          "minProperties": 1,
          "type": "object"
        },
        "contract_version": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/semver"
        },
        "environment": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/environment"
        },
        "image_digest": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "module_versions": {
          "additionalProperties": {
            "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/semver"
          },
          "minProperties": 1,
          "type": "object"
        },
        "region": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/region"
        },
        "resolved_platform": {
          "additionalProperties": false,
          "properties": {
            "fargate": {
              "minLength": 1,
              "type": "string"
            },
            "lambda_runtime": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "fargate",
            "lambda_runtime"
          ],
          "type": "object"
        },
        "source_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        "task_definition_arn": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
        },
        "tool_versions": {
          "additionalProperties": {
            "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/semver"
          },
          "minProperties": 1,
          "type": "object"
        },
        "workflow": {
          "additionalProperties": false,
          "properties": {
            "job_workflow_ref": {
              "minLength": 1,
              "type": "string"
            },
            "run_id": {
              "minimum": 1,
              "type": "integer"
            },
            "workflow_sha": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            }
          },
          "required": [
            "job_workflow_ref",
            "run_id",
            "workflow_sha"
          ],
          "type": "object"
        }
      },
      "required": [
        "account_id",
        "region",
        "environment",
        "source_commit",
        "image_digest",
        "task_definition_arn",
        "module_versions",
        "contract_version",
        "workflow",
        "tool_versions",
        "resolved_platform",
        "artifact_checksums"
      ],
      "type": "object"
    },
    "schema_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "deployment_identity_id",
    "identity"
  ],
  "title": "Deployment Identity",
  "type": "object"
}
