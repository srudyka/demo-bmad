{
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:pilot-launch-checklist",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pilot Launch Checklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "checklist_id", "status", "bindings", "jobs", "fields", "controls", "observation_contract", "qualifying_change_catalog", "evidence_manifest", "approval_matrix", "rollback_criteria", "initiator", "history", "deployment_identity_sha256", "preflight_evidence_sha256", "operations", "rollout_policy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "checklist_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[A-Za-z0-9._/-]+$"},
    "status": {"enum": ["BLOCKED", "READY_FOR_REVIEW", "APPROVED_TO_START", "IN_PROGRESS", "PAUSED", "EVIDENCE_PENDING"]},
    "bindings": {"$ref": "#/$defs/bindings"},
    "jobs": {"type": "array", "maxItems": 2, "items": {"$ref": "#/$defs/job"}},
    "fields": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/field"}},
    "controls": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/control"}},
    "observation_contract": {"$ref": "#/$defs/observation"},
    "qualifying_change_catalog": {"$ref": "#/$defs/catalog"},
    "evidence_manifest": {"type": "array", "items": {"$ref": "#/$defs/evidence"}},
    "approval_matrix": {"$ref": "#/$defs/approval_matrix"},
    "rollback_criteria": {"$ref": "#/$defs/rollback"},
    "initiator": {"type": "string", "minLength": 1, "maxLength": 256},
    "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}},
    "deployment_identity_sha256": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/hash"}},
    "preflight_evidence_sha256": {"$ref": "#/$defs/hash"},
    "operations": {"$ref": "#/$defs/operations"},
    "rollout_policy": {"$ref": "#/$defs/rollout_policy"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["release_version", "compatibility_package_sha256", "source_commit", "workflow_sha", "workflow_run_id", "account_id", "region", "environment", "pilot_id", "target_manifest_sha256", "module_version", "workflow_version", "observation_window"], "properties": {"release_version": {"type": "string", "minLength": 1}, "compatibility_package_sha256": {"$ref": "#/$defs/hash"}, "source_commit": {"$ref": "#/$defs/sha1"}, "workflow_sha": {"$ref": "#/$defs/sha1"}, "workflow_run_id": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "pattern": "^[0-9]{12}$"}, "region": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "pilot_id": {"type": "string", "minLength": 1}, "target_manifest_sha256": {"$ref": "#/$defs/hash"}, "module_version": {"type": "string", "minLength": 1}, "workflow_version": {"type": "string", "minLength": 1}, "observation_window": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"$ref": "#/$defs/timestamp"}, "end": {"$ref": "#/$defs/timestamp"}}}}},
    "job": {"type": "object", "additionalProperties": false, "required": ["job_id", "repository", "application_owner", "operational_owner", "risk_class", "environment", "account_id", "region", "dependencies", "side_effects"], "properties": {"job_id": {"type": "string", "minLength": 1}, "repository": {"type": "string", "minLength": 1}, "application_owner": {"type": "string", "minLength": 1}, "operational_owner": {"type": "string", "minLength": 1}, "risk_class": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "pattern": "^[0-9]{12}$"}, "region": {"type": "string", "minLength": 1}, "dependencies": {"type": "array"}, "side_effects": {"type": "array"}}},
    "field": {"type": "object", "additionalProperties": false, "required": ["field_id", "owner", "evidence_type", "due_at", "status", "blocking", "source_refs"], "properties": {"field_id": {"type": "string", "minLength": 1}, "owner": {"type": "string", "minLength": 1}, "evidence_type": {"type": "string", "minLength": 1}, "due_at": {"$ref": "#/$defs/timestamp"}, "status": {"enum": ["complete", "missing", "failed", "unknown", "inconclusive", "not-applicable"]}, "blocking": {"type": "boolean"}, "source_refs": {"type": "array", "items": {"type": "string"}}}},
    "control": {"type": "object", "additionalProperties": false, "required": ["control_id", "status", "blocking", "evidence_ids", "invalidates"], "properties": {"control_id": {"type": "string", "minLength": 1}, "status": {"enum": ["passed", "missing", "failed", "unknown", "inconclusive", "not-applicable"]}, "blocking": {"type": "boolean"}, "evidence_ids": {"type": "array", "items": {"type": "string"}}, "invalidates": {"type": "array", "items": {"type": "string"}}}},
    "observation": {"type": "object", "additionalProperties": false, "required": ["version", "minimum_duration_seconds", "minimum_occurrences", "schedule_frequencies", "healthy_windows", "controlled_failures", "alert_latency_target_seconds", "false_alert_limit", "lost_alert_limit", "setup_time_method", "review_categories", "recovery_rehearsal_required", "stop_conditions"], "properties": {"version": {"type": "string", "minLength": 1}, "minimum_duration_seconds": {"type": "integer", "minimum": 0}, "minimum_occurrences": {"type": "integer", "minimum": 0}, "schedule_frequencies": {"type": "array", "minItems": 1}, "healthy_windows": {"type": "array", "minItems": 1}, "controlled_failures": {"type": "array", "minItems": 1}, "alert_latency_target_seconds": {"type": "integer", "minimum": 0}, "false_alert_limit": {"type": "integer", "minimum": 0}, "lost_alert_limit": {"type": "integer", "minimum": 0}, "setup_time_method": {"type": "string", "minLength": 1}, "review_categories": {"type": "array", "minItems": 1}, "recovery_rehearsal_required": {"type": "boolean"}, "stop_conditions": {"type": "array", "minItems": 1}}},
    "catalog": {"type": "object", "additionalProperties": false, "required": ["version", "changes"], "properties": {"version": {"type": "string", "minLength": 1}, "changes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["change_id", "class", "behavioral", "invalidates", "security_approval_required"], "properties": {"change_id": {"type": "string", "minLength": 1}, "class": {"type": "string", "minLength": 1}, "behavioral": {"type": "boolean"}, "invalidates": {"type": "array"}, "security_approval_required": {"type": "boolean"}}}}}},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["evidence_id", "kind", "sha256", "source_revision", "status", "sensitivity", "redacted", "binding"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "kind": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "source_revision": {"$ref": "#/$defs/sha1"}, "status": {"enum": ["verified", "pending", "failed", "synthetic"]}, "sensitivity": {"enum": ["public-sanitized", "internal-sanitized", "protected-reference"]}, "redacted": {"const": true}, "binding": {"type": "object", "additionalProperties": false, "required": ["source_commit", "workflow_run_id", "account_id", "region", "environment", "pilot_id", "job_id"], "properties": {"source_commit": {"$ref": "#/$defs/sha1"}, "workflow_run_id": {"type": "string", "minLength": 1}, "account_id": {"type": "string", "pattern": "^[0-9]{12}$"}, "region": {"type": "string", "minLength": 1}, "environment": {"type": "string", "minLength": 1}, "pilot_id": {"type": "string", "minLength": 1}, "job_id": {"type": "string", "minLength": 1}}}}},
    "approval_matrix": {"type": "object", "additionalProperties": false, "required": ["required_roles", "security_trigger_classes", "self_review_prevention", "protected_environment_verified", "branch_protection_verified", "emergency_bypass_policy"], "properties": {"required_roles": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "security_trigger_classes": {"type": "array", "items": {"type": "string"}}, "self_review_prevention": {"type": "boolean"}, "protected_environment_verified": {"type": "boolean"}, "branch_protection_verified": {"type": "boolean"}, "emergency_bypass_policy": {"type": "string", "minLength": 1}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["disable_launch_first", "known_good_identity_sha256", "compensation_owner", "rto_seconds", "stop_actions", "verification_steps"], "properties": {"disable_launch_first": {"const": true}, "known_good_identity_sha256": {"$ref": "#/$defs/hash"}, "compensation_owner": {"type": "string", "minLength": 1}, "rto_seconds": {"type": "integer", "minimum": 1}, "stop_actions": {"type": "array", "minItems": 1}, "verification_steps": {"type": "array", "minItems": 1}}},
    "history": {"type": "object", "additionalProperties": false, "required": ["event_id", "status", "at", "actor", "reason", "record_sha256"], "properties": {"event_id": {"type": "string", "minLength": 1}, "status": {"enum": ["BLOCKED", "READY_FOR_REVIEW", "APPROVED_TO_START", "IN_PROGRESS", "PAUSED", "EVIDENCE_PENDING"]}, "at": {"$ref": "#/$defs/timestamp"}, "actor": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "record_sha256": {"$ref": "#/$defs/hash"}}},
    "operations": {"type": "object", "additionalProperties": false, "required": ["notification_target", "escalation_policy", "notification_verified", "escalation_verified"], "properties": {"notification_target": {"type": "string", "minLength": 1}, "escalation_policy": {"type": "string", "minLength": 1}, "notification_verified": {"const": true}, "escalation_verified": {"const": true}}},
    "rollout_policy": {"type": "object", "additionalProperties": false, "required": ["support_owner", "supported_versions", "deprecation_communication", "exception_policy", "rollback_pause_criteria", "rollout_scope"], "properties": {"support_owner": {"type": "string", "minLength": 1}, "supported_versions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "deprecation_communication": {"type": "string", "minLength": 1}, "exception_policy": {"type": "string", "minLength": 1}, "rollback_pause_criteria": {"type": "string", "minLength": 1}, "rollout_scope": {"type": "string", "minLength": 1}}}
  }
}
