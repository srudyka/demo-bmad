            "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "task_arn": {}
  },
  "required": [
    "attempt_no",
    "cluster_arn",
    "client_token_digest",
    "task_arn",
    "failures"
  ],
  "title": "Task Launch Result Evidence Payload",
  "type": "object"
