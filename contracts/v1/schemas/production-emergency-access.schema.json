{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:production-emergency-access",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "actor", "approver", "target_manifest_sha256", "operation", "expires_at", "alert_id", "incident_id", "review_due_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "status": {"const": "approved"}, "actor": {"type": "string", "minLength": 1}, "approver": {"type": "string", "minLength": 1}, "target_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "operation": {"type": "string", "enum": ["disable", "rollback", "forward-fix"]}, "expires_at": {"type": "string", "format": "date-time"}, "alert_id": {"type": "string", "minLength": 1}, "incident_id": {"type": "string", "minLength": 1}, "review_due_at": {"type": "string", "format": "date-time"}
  }
}
