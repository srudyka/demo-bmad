{
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:pilot-measurement-definition",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pilot Measurement Definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "calculation_version", "definition_id", "owner", "generated_at", "observation_window", "bindings", "metrics"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "calculation_version": {"type": "string", "minLength": 1},
    "definition_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "observation_window": {
      "type": "object", "additionalProperties": false, "required": ["start", "end"],
      "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "metrics": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/metric"}}
  },
  "$defs": {
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["release_version", "compatibility_package_sha256", "source_commit", "workflow_sha", "workflow_run_id", "account_id", "region", "environment", "pilot_id"],
      "properties": {
        "release_version": {"type": "string", "minLength": 1},
        "compatibility_package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workflow_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "workflow_run_id": {"type": "string", "minLength": 1},
        "account_id": {"type": "string", "pattern": "^[0-9]{12}$"},
        "region": {"type": "string", "minLength": 1},
        "environment": {"type": "string", "minLength": 1},
        "pilot_id": {"type": "string", "minLength": 1}
      }
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["metric_id", "owner", "unit", "start_event", "stop_event", "inclusion_rules", "exclusions", "evidence_sources", "calculation", "target", "comparability_dimensions"],
      "properties": {
        "metric_id": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "unit": {"type": "string", "minLength": 1},
        "start_event": {"type": "string", "minLength": 1},
        "stop_event": {"type": "string", "minLength": 1},
        "inclusion_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclusions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_sources": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "calculation": {"type": "string", "minLength": 1},
        "target": {"type": "object", "additionalProperties": false, "required": ["operator", "value", "unit"], "properties": {"operator": {"type": "string"}, "value": {"type": "number"}, "unit": {"type": "string"}}},
        "comparability_dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
