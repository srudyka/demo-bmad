{
  "$defs": {
    "account_id": {
      "pattern": "^[0-9]{12}$",
      "type": "string"
    },
    "arn": {
      "pattern": "^arn:(aws|aws-us-gov|aws-cn):[a-z0-9-]+:[a-z0-9-]*:[0-9]{0,12}:[^\\s]+$",
      "type": "string"
    },
    "environment": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "event_type": {
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*\\.v1$",
      "type": "string"
    },
    "job_id": {
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}/[a-z0-9][a-z0-9-]{0,62}/[a-z0-9][a-z0-9-]{0,62}$",
      "type": "string"
    },
    "machine_code": {
      "pattern": "^[A-Z][A-Z0-9_]{1,63}$",
      "type": "string"
    },
    "occurrence_state": {
      "enum": [
        "EXPECTED",
        "STARTED",
        "SUCCEEDED",
        "FAILED",
        "OVERDUE",
        "MISSED",
        "AMBIGUOUS"
      ],
      "type": "string"
    },
    "producer_id": {
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
    },
    "region": {
      "pattern": "^[a-z]{2}(?:-gov)?-[a-z]+-[0-9]+$",
      "type": "string"
    },
    "secret_reference": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "arn": {
              "$ref": "#/$defs/arn"
            },
            "json_key": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "const": "secrets_manager"
            },
            "version_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "provider",
            "arn",
            "version_id"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "kms_key_arn": {
              "$ref": "#/$defs/arn"
            },
            "name": {
              "pattern": "^/[A-Za-z0-9_.@/-]+$",
              "type": "string"
            },
            "provider": {
              "const": "ssm_parameter"
            },
            "version": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "provider",
            "name",
            "version"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "locator": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            "provider": {
              "const": "approved_platform"
            },
            "version": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "provider",
            "locator",
            "version"
          ],
          "type": "object"
        }
      ]
    },
    "semver": {
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "timestamp": {
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-([0-2][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]\\.[0-9]{3}Z$",
      "type": "string"
    },
    "uuid_v7": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    }
  },
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compatibility Package Common Definitions",
  "type": "object"
}
