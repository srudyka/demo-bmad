{
  "$id": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:config",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "config": {
      "additionalProperties": false,
      "properties": {
        "cluster_arn": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
        },
        "completion_window_seconds": {
          "maximum": 86400,
          "minimum": 60,
          "type": "integer"
        },
        "deployment_identity_id": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/sha256"
        },
        "job_id": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/job_id"
        },
        "logs": {
          "additionalProperties": false,
          "properties": {
            "log_group_arn": {
              "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
            },
            "retention_days": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "log_group_arn",
            "retention_days"
          ],
          "type": "object"
        },
        "network": {
          "additionalProperties": false,
          "properties": {
            "assign_public_ip": {
              "const": "DISABLED"
            },
            "security_group_ids": {
              "items": {
                "pattern": "^sg-[0-9a-f]+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            },
            "subnet_ids": {
              "items": {
                "pattern": "^subnet-[0-9a-f]+$",
                "type": "string"
              },
              "minItems": 1,
              "type": "array",
              "uniqueItems": true
            }
          },
          "required": [
            "subnet_ids",
            "security_group_ids",
            "assign_public_ip"
          ],
          "type": "object"
        },
        "notification_target_arn": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
        },
        "overlap_policy": {
          "enum": [
            "APPLICATION_IDEMPOTENT",
            "APPLICATION_LOCKED"
          ],
          "type": "string"
        },
        "owner_generation": {
          "minimum": 1,
          "type": "integer"
        },
        "role_arns": {
          "additionalProperties": false,
          "properties": {
            "execution": {
              "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
            },
            "launch": {
              "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
            },
            "task": {
              "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
            }
          },
          "required": [
            "execution",
            "task",
            "launch"
          ],
          "type": "object"
        },
        "schedule": {
          "additionalProperties": false,
          "properties": {
            "activation_end": {
              "oneOf": [
                {
                  "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/timestamp"
                },
                {
                  "type": "null"
                }
              ]
            },
            "activation_start": {
              "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/timestamp"
            },
            "expression": {
              "minLength": 1,
              "type": "string"
            },
            "flexible_time_window": {
              "const": "OFF"
            },
            "evaluator_version": {
              "const": "schedule-evaluator/1.0.0"
            },
            "start_anchor": {
              "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/timestamp"
            },
            "time_zone": {
              "minLength": 1,
              "type": "string"
            },
            "tzdb_version": {
              "const": "2026b"
            }
          },
          "required": [
            "expression",
            "time_zone",
            "start_anchor",
            "activation_start",
            "activation_end",
            "flexible_time_window",
            "evaluator_version",
            "tzdb_version"
          ],
          "type": "object"
        },
        "schedule_arn": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
        },
        "schedule_generation": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/sha256"
        },
        "scheduler_delivery_role_id": {
          "pattern": "^AROA[A-Z0-9]+$",
          "type": "string"
        },
        "secret_references": {
          "items": {
            "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/secret_reference"
          },
          "type": "array"
        },
        "task_definition_arn": {
          "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/arn"
        }
      },
      "required": [
        "job_id",
        "owner_generation",
        "schedule",
        "schedule_arn",
        "schedule_generation",
        "scheduler_delivery_role_id",
        "task_definition_arn",
        "cluster_arn",
        "network",
        "role_arns",
        "completion_window_seconds",
        "overlap_policy",
        "logs",
        "notification_target_arn",
        "secret_references",
        "deployment_identity_id"
      ],
      "type": "object"
    },
    "config_version": {
      "$ref": "urn:demo-bmad:ecs-scheduled-jobs:contract:1.0.0:schema:common#/$defs/sha256"
    },
    "schema_version": {
      "pattern": "^1\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "config_version",
    "config"
  ],
  "title": "Job CONFIG",
  "type": "object"
}
