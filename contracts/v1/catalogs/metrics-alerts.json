{
  "alarm_contract": {
    "dimensions": ["job_id", "environment", "state"],
    "missing_data": "breaching for expected-completion alarms; notBreaching for event-driven failure counters",
    "name": "<environment>/<job-id>/<state>",
    "owner": "application-owner",
    "threshold": 1
  },
  "alert_required_fields": [
    "environment",
    "detected_at",
    "failure_plane",
    "deployment_identity_id",
    "account_id",
    "region",
    "notification_target_arn",
    "runbook_uri"
  ],
  "forbidden_dimensions": ["occurrence_id", "task_arn", "command_id"],
  "metric_dimensions": ["job_id", "environment", "state"],
  "outbox_identity": ["job_id", "occurrence_id", "state", "failure_plane"],
  "notification_ledger": {
    "statuses": ["PENDING", "DELIVERED", "AMBIGUOUS", "REJECTED"],
    "retry_horizon_seconds": 1209600,
    "separate_from_occurrence_state": true
  },
  "occurrence_alert_states": ["FAILED", "MISSED", "OVERDUE", "AMBIGUOUS"],
  "cell_health": {
    "bounded_dimensions": ["cell_id", "component", "environment", "failure_plane", "job_id", "state"],
    "forbidden_dimensions": ["occurrence_id", "task_arn", "log_stream", "error_text", "source_arn", "target_arn"],
    "heartbeat_metric": "CanaryProcessedHeartbeat",
    "freshness_alarm": {
      "evaluation_periods": 5,
      "missing_data": "breaching",
      "period_seconds": 60,
      "threshold": 1
    },
    "runbook_uri_required": true,
    "alarm_definitions": {
      "scheduler_delivery_failures": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "scheduler_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "source_queue_age": {"metric": "ApproximateAgeOfOldestMessage", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "ingress_queue_age": {"metric": "ApproximateAgeOfOldestMessage", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "lambda_errors": {"metric": "Errors", "namespace": "AWS/Lambda", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "lambda_throttles": {"metric": "Throttles", "namespace": "AWS/Lambda", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "dynamodb_throttles": {"metric": "ThrottledRequests", "namespace": "AWS/DynamoDB", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "deadline_lag": {"metric": "DeadlineScannerWatermarkAge", "namespace": "cell", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "outbox_reconciliation": {"metric": "ReconciliationFailure", "namespace": "cell", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "scheduler_attempts": {"metric": "NumberOfMessagesSent", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "notBreaching", "severity": "high", "owner_required": true},
      "scheduler_queue_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "process_manager_queue_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "every_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "deadline_source_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "ecs_event_source_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "completion_source_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "normalizer_ingress_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "process_manager_ingress_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "normalizer_quarantine_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "materializer_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "command_handler_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "alert_router_dlq_depth": {"metric": "ApproximateNumberOfMessagesVisible", "namespace": "AWS/SQS", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "lambda_duration": {"metric": "Duration", "namespace": "AWS/Lambda", "threshold": 5000, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "notBreaching", "severity": "high", "owner_required": true},
      "lambda_concurrency": {"metric": "ConcurrentExecutions", "namespace": "AWS/Lambda", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "notBreaching", "severity": "high", "owner_required": true},
      "dynamodb_conditional_failures": {"metric": "ConditionalCheckFailedRequests", "namespace": "AWS/DynamoDB", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "notBreaching", "severity": "high", "owner_required": true},
      "log_subscription_delivery": {"metric": "DeliveryErrors", "namespace": "AWS/Logs", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "notBreaching", "severity": "high", "owner_required": true},
      "notification_delivery": {"metric": "NotificationDelivered", "namespace": "cell", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "notBreaching", "severity": "high", "owner_required": true},
      "expectation_horizon_freshness": {"metric": "DeadlineScannerWatermarkAge", "namespace": "cell", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "schedule_conformance": {"metric": "CanaryProcessedHeartbeat", "namespace": "cell", "threshold": 1, "evaluation_periods": 5, "period_seconds": 60, "missing_data": "breaching", "severity": "critical", "owner_required": true},
      "recovery_blocked": {"metric": "RecoveryBlocked", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true},
      "recovery_restore_failure": {"metric": "RecoveryRestoreFailure", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true},
      "recovery_integrity_failure": {"metric": "RecoveryIntegrityFailure", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true},
      "recovery_replay_failure": {"metric": "RecoveryReplayFailure", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true},
      "recovery_verification_failure": {"metric": "RecoveryVerificationFailure", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true}
      ,"lifecycle_cleanup_blocked": {"metric": "LifecycleCleanupBlocked", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true}
      ,"lifecycle_cleanup_failure": {"metric": "LifecycleCleanupFailure", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true}
      ,"lifecycle_late_reference": {"metric": "LifecycleLateReference", "namespace": "cell", "threshold": 1, "evaluation_periods": 1, "period_seconds": 60, "missing_data": "notBreaching", "severity": "critical", "owner_required": true}
    }
  },
  "schema_version": "1.0.0"
}
