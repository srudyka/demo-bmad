{
  "schema_version": "1.0.0",
  "policy_id": "production-readiness",
  "policy_version": "1.0.0",
  "production_disposition": "BLOCK",
  "non_production_adoption": {"phase": "advisory-then-blocking", "blocking_release": "1.0.0"},
  "non_exemptible": ["TARGET_BINDING", "PLAINTEXT_SECRET", "PRIVILEGE_ESCALATION", "MUTABLE_DEPLOYMENT_IDENTITY", "OCCURRENCE_TRACKING_MISSING"],
  "qualifying_change_categories": ["iam", "network", "launch", "supply-chain", "other"],
  "qualifying_change_policy": {"iam": {"scope": "aws_iam|aws_oidc", "risk_threshold": "high", "reviewers": ["security"]}, "network": {"scope": "aws_vpc|aws_subnet|aws_security_group|aws_route", "risk_threshold": "high", "reviewers": ["security"]}, "launch": {"scope": "aws_scheduler|aws_ecs|aws_task", "risk_threshold": "high", "reviewers": ["platform"]}, "supply-chain": {"scope": "aws_ecr|github|workflow|provider|module", "risk_threshold": "high", "reviewers": ["security"]}, "other": {"scope": "aws_cloudwatch|aws_lambda|aws_s3|aws_sqs|aws_sns|aws_secretsmanager", "risk_threshold": "medium", "reviewers": ["platform"]}},
  "exception_owner": "platform-security",
  "exception_required_fields": ["policy_id", "policy_version", "address", "environment", "source_commit", "plan_sha256", "owner", "justification", "approver", "compensating_control", "expires_at", "review_at", "signature"],
  "unknown_policy_disposition": "BLOCK"
  ,"required_production_controls": {
    "tags": ["Environment", "Application", "Service", "Owner", "ManagedBy"],
    "observability": ["logs", "retention", "alarms", "notifications"],
    "lifecycle": ["acknowledgement", "cell_contract"]
  }
  ,"rules": {
    "iam": {"administrator_actions": ["*:*", "iam:*", "sts:AssumeRole"], "deny_wildcards": true, "require_conditions": true},
    "network": {"forbidden_cidrs": ["0.0.0.0/0", "::/0"], "public_ip": false},
    "schedule": {"lifecycle": ["RESERVED", "PUBLISHED", "VALIDATED", "MATERIALIZED", "ENABLED"], "direct_ecs": false},
    "supply_chain": {"forbidden_paths": [".terraform", ".tfvars", "terraform.tfstate", "*.tfplan"], "mutable_image_tag": "latest"}
  }
}
