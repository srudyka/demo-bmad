{
  "allowed_reference_field_names": [
    "arn",
    "json_key",
    "kms_key_arn",
    "locator",
    "name",
    "provider",
    "secret_references",
    "version",
    "version_id"
  ],
  "forbidden_field_name_patterns": [
    "(?i)(^|[-_.])(api[_-]?key|client[_-]?secret|password|private[_-]?key|secret|secret[_-]?value|token)([-_.]|$)"
  ],
  "forbidden_value_patterns": [
    "^forbidden-secret-sentinel:",
    "^-----BEGIN [A-Z ]+PRIVATE KEY-----$"
  ],
  "policy_version": "1.0.0",
  "reference_providers": [
    "approved_platform",
    "secrets_manager",
    "ssm_parameter"
  ]
}
